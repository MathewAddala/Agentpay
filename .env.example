# ============================================
# Agent-to-Agent Commerce Simulation
# Environment Configuration (EXAMPLE)
# ============================================
# Copy this to .env and fill in your keys

# Razorpay Test Mode — Get from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Groq LLM — Get from https://console.groq.com/
GROQ_API_KEY=gsk_xxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Application Config
SIMULATE_PAYMENT_FAILURE=true
MERCHANT_URL=http://localhost:8001
BUYER_URL=http://localhost:8002
DATABASE_PATH=./data/commerce.db

# Service Ports
MERCHANT_HOST=0.0.0.0
MERCHANT_PORT=8001
BUYER_HOST=0.0.0.0
BUYER_PORT=8002
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
